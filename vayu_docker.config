#
# ===== Docker / OCI container support for Helios vayu =====
# Append verbatim to arch/arm64/configs/vayu_user_defconfig
# Order matters: kconfig reads sequentially and last-wins, so parent
# symbols (SYSVIPC, NAMESPACES, CGROUPS) MUST precede their children.
#

# --- parents first (dependency roots) ---
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- namespaces: the actual blocker on the stock Helios kernel ---
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- cgroup controllers Docker requires ---
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y

# --- bridge / veth networking ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_VXLAN=y

# --- netfilter: ADDRTYPE is mandatory, dockerd's iptables rules use -m addrtype ---
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- overlay2 storage driver ---
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y

# --- misc runtime requirements ---
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- re-assert children whose parents were only enabled above ---
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
